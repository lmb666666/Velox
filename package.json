{
  "name": "velox",
  "version": "0.2.0",
  "private": true,
  "description": "Velox —— 调用 itdog.cn 全国监测节点测速（ping/tcping/http/dns/traceroute，支持批量与精确节点），预留多上游扩展",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=18.14"
  },
  "bin": {
    "velox": "dist/cli.js",
    "itdog": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "serve": "node dist/cli.js serve",
    "refresh-guard": "node scripts/refresh-guard.mjs",
    "extract-strings": "node scripts/extract-strings.mjs",
    "fetch-china-geo": "node scripts/fetch-china-geo.mjs",
    "check:web": "tsc -p web --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "layout-check": "node scripts/layout-check.mjs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "d3-geo": "^3.1.1",
    "framer-motion": "^13.2.0",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "undici": "^8.10.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
